#
# Lokale Entwicklungsumgebung (`cargo run`)
#
LISTEN=[::1]:8000
PG__URL=postgres://postgres:postgres@localhost:5432/einerleih
SESSION_COOKIE_NAME=einerleih_session
SESSION_COOKIE_SECURE=false
PUBLIC_API_URL=http://localhost:8000
# Mit Vite lokal:
# PUBLIC_APP_URL=http://localhost:5173
# Ohne Vite / wenn das Frontend direkt vom Backend ausgeliefert wird:
PUBLIC_APP_URL=http://localhost:8000
NOTIFICATION_FILE_OUTPUT_DIR=tmp/notifications
#
# Asset-Konfiguration
#
ASSETS_HOME_PATH=assets
ASSETS_PUBLIC_PATH=${ASSETS_HOME_PATH}/public
ASSETS_PUBLIC_URL=/assets/public
ASSETS_PRIVATE_PATH=${ASSETS_HOME_PATH}/private
ASSETS_PRIVATE_URL=/assets/private
ASSET_MAX_SIZE=5242880

#
# Docker Compose / Deployment
# Diese Werte werden von docker compose aus der .env gelesen.
# Die App selbst bekommt im Container daraus zusammengesetzte Runtime-Variablen.
#
POSTGRES_PASSWORD=change-me
IMAGE_REF=ghcr.io/narslan/einerleih:latest

#
# Optionaler Bootstrap-Admin für frühe Deployments.
# Wenn BOOTSTRAP_ADMIN_USERNAME gesetzt ist, muss auch BOOTSTRAP_ADMIN_PASSWORD gesetzt sein.
#
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me
