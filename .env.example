#
# Lokale Entwicklungsumgebung (`cargo run`)
#
LISTEN=[::1]:8000
PG__URL=postgres://postgres:postgres@localhost:5432/einerleih
# openssl rand -base64 32
JWT_SECRET_KEY=change-me-to-a-random-base64-secret

#
# Asset-Konfiguration
#
ASSETS_HOME_PATH=assets
ASSETS_PUBLIC_PATH=${ASSETS_HOME_PATH}/public
ASSETS_PUBLIC_URL=/assets/public
ASSETS_PRIVATE_PATH=${ASSETS_HOME_PATH}/private
ASSETS_PRIVATE_URL=/assets/private
ASSET_MAX_SIZE=5242880

#
# Docker Compose / Deployment
# Diese Werte werden von docker compose aus der .env gelesen.
# Die App selbst bekommt im Container daraus zusammengesetzte Runtime-Variablen.
#
POSTGRES_PASSWORD=change-me
IMAGE_REF=ghcr.io/narslan/einerleih:latest
